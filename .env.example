# Port et adresse d'écoute de l'API (0.0.0.0 = accessible depuis le téléphone sur le même réseau)
PORT=3000
HOST=0.0.0.0
# URL publique de l'application (cookies "Secure" automatiques si https)
PUBLIC_URL=http://localhost:5173
DATABASE_PATH=data/kairn.db

# Synchronisation Strava (pont Garmin Connect → Strava → Kairn)
# Crée une application sur https://www.strava.com/settings/api
# avec comme "Authorization Callback Domain" le domaine de PUBLIC_URL.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Synchronisation automatique : notifications Strava (si PUBLIC_URL est en https, désactivables avec off)
# et synchronisation périodique de rattrapage, en minutes.
STRAVA_WEBHOOK=
STRAVA_SYNC_INTERVAL_MIN=30

# Dossier surveillé pour l'import automatique des .FIT (ex. montre Garmin branchée en USB)
GARMIN_WATCH_DIR=
GARMIN_WATCH_EMAIL=
GARMIN_WATCH_INTERVAL_S=30

# Dossier GARMIN/NewFiles de la montre montée en USB : envoi direct des séances structurées (.FIT)
GARMIN_NEWFILES_DIR=

# Notifications (Web Push) : les clés sont générées au premier démarrage et gardées en base.
# Contact transmis aux services de push (mailto: ou https://) ; par défaut, PUBLIC_URL si elle est en https.
VAPID_SUBJECT=
