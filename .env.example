# API listening port and address (0.0.0.0 = reachable from a phone on the same network)
PORT=3000
HOST=0.0.0.0
# Public URL of the application ("Secure" cookies are automatic with https)
PUBLIC_URL=http://localhost:5173
DATABASE_PATH=data/kairn.db

# Strava sync (Garmin Connect → Strava → Kairn bridge)
# Create an application at https://www.strava.com/settings/api
# with the PUBLIC_URL domain as its "Authorization Callback Domain".
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Automatic sync: Strava notifications (when PUBLIC_URL is https, can be disabled with off)
# and periodic catch-up sync, in minutes.
STRAVA_WEBHOOK=
STRAVA_SYNC_INTERVAL_MIN=30

# Folder watched for automatic .FIT import (e.g. a Garmin watch plugged in over USB)
GARMIN_WATCH_DIR=
GARMIN_WATCH_EMAIL=
GARMIN_WATCH_INTERVAL_S=30

# GARMIN/NewFiles folder of the watch mounted over USB: sends structured sessions (.FIT) directly
GARMIN_NEWFILES_DIR=

# Notifications (Web Push): the keys are generated on first start and kept in the database.
# Contact passed to the push services (mailto: or https://); defaults to PUBLIC_URL when it is https.
VAPID_SUBJECT=
